[Unit]
Description=MonopolyPro authoritative multiplayer server
After=network.target

[Service]
Type=simple
User=monopolypro
Group=monopolypro
WorkingDirectory=/opt/monopolypro/current
EnvironmentFile=/etc/monopolypro.env
ExecStart=/usr/bin/node dist/server/index.js
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/monopolypro
MemoryMax=1G
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
