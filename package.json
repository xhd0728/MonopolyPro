{
  "name": "monopolypro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch apps/server/src/index.ts",
    "dev:client": "vite --config apps/client/vite.config.ts",
    "start": "node dist/server/index.js",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "test:load": "tsx scripts/load.ts",
    "release": "node scripts/release.mjs",
    "format": "prettier --write apps packages tests scripts *.ts *.json *.yaml",
    "format:check": "prettier --check apps packages tests scripts *.ts *.json *.yaml"
  },
  "dependencies": {
    "@colyseus/core": "0.18.18",
    "@colyseus/sdk": "0.18.5",
    "@colyseus/ws-transport": "0.18.4",
    "express": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.180.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.180.0",
    "esbuild": "0.25.12",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
