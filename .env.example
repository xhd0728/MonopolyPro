HOST=127.0.0.1
PORT=8788
NODE_ENV=production
DATA_DIR=./data
PUBLIC_ORIGIN=https://monopoly.example.com
MAX_ROOMS=200
DISCONNECT_TAKEOVER_MS=15000
BOT_STEP_MS=1200
DECISION_TIMEOUT_MS=45000
ROOM_IDLE_MS=86400000

# Optional server-only LLM robots. No key is sent to the browser.
MONOPOLY_AI_ENABLED=false
MONOPOLY_AI_API_MODE=chat
MONOPOLY_AI_BASE_URL=https://api.example.com/v1
MONOPOLY_AI_MODEL=
MONOPOLY_AI_KEY=
MONOPOLY_AI_TIMEOUT_MS=12000
MONOPOLY_AI_MAX_CONCURRENT=4
# Compatible providers may support disabling reasoning for short JSON decisions.
MONOPOLY_AI_DISABLE_THINKING=false
# Optional chat-provider reasoning effort; leave empty for standard providers.
MONOPOLY_AI_REASONING_EFFORT=
