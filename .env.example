HOST=127.0.0.1
PORT=8788
NODE_ENV=production
DATA_DIR=./data
PUBLIC_ORIGIN=https://monopoly.example.com
MAX_ROOMS=200
DISCONNECT_TAKEOVER_MS=15000
BOT_STEP_MS=1200
# Rooms close after 30 min without human interaction, or 3 min after the last human left;
# closed rooms are deleted 10 min later.
ROOM_IDLE_MS=1800000
ROOM_EMPTY_CLOSE_MS=180000
ROOM_CLOSED_TTL_MS=600000

# Optional server-only LLM robots. No key is sent to the browser.
MONOPOLY_AI_ENABLED=false
MONOPOLY_AI_API_MODE=chat
MONOPOLY_AI_BASE_URL=https://api.example.com/v1
MONOPOLY_AI_MODEL=
MONOPOLY_AI_KEY=
# Per LLM request; at most 120000 (each AI decision is capped at two minutes).
MONOPOLY_AI_TIMEOUT_MS=20000
MONOPOLY_AI_MAX_CONCURRENT=8
# Compatible providers may support disabling reasoning for short JSON decisions.
MONOPOLY_AI_DISABLE_THINKING=false
# Optional chat-provider reasoning effort; leave empty for standard providers.
MONOPOLY_AI_REASONING_EFFORT=
# Upper bound for read-only tool calls (look ahead, inspect squares/players, preview, rule advice)
# per decision; each difficulty uses fewer (easy 0, normal 2, hard 4).
MONOPOLY_AI_MAX_STEPS=4
# tools = native function calling (default); json = plain JSON replies for endpoints without tools.
# An endpoint that rejects tool definitions is switched to json automatically.
MONOPOLY_AI_PROTOCOL=tools
